VITE_TMDB_KEY=
VITE_COLLAPS_TOKEN=
VITE_COLLAPS_API=
VITE_ALLOHA_TOKEN=
# Email админа для UI-подсказок. Реальные права выдаёт сервер:
# на VPS задай HADES_ADMIN_EMAIL с тем же значением (см. server/local-api.py)
VITE_ADMIN_EMAIL=your@email.com

# Вайтлист: 'off' = все автоматически одобрены, любое другое значение = нужно одобрение админа
# VITE_WHITELIST=off

# HDRezka resolver is built from VITE_HADES_API_URL + /hdrezka.
# The old Supabase Edge Function URL is no longer used.

# Firebase Auth (Google provider): Firebase Console → Project settings → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
