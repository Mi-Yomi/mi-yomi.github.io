# Expo bakes EXPO_PUBLIC_* into the app bundle at build time.
# Copy to mobile/.env and fill in (the same values the web app uses).

# Self-hosted HADES API: auth, profiles, friends, library, HDRezka resolver.
# Defaults to the production URL in lib/config.js if left unset.
EXPO_PUBLIC_HADES_API_URL=https://hades.20-235-109-146.sslip.io/api

EXPO_PUBLIC_TMDB_KEY=
EXPO_PUBLIC_COLLAPS_TOKEN=
EXPO_PUBLIC_COLLAPS_API=
EXPO_PUBLIC_ALLOHA_TOKEN=

# Optional: email that gets admin rights in the UI. Real rights are decided by
# the server from HADES_ADMIN_EMAIL.
EXPO_PUBLIC_ADMIN_EMAIL=
