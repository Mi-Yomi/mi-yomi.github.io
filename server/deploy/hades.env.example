# /etc/hades/hades.env — HADES API environment (root:hades, mode 640).
# Every variable is read by server/local-api.py; see DEPLOY.md for details.
HADES_DB_PATH=/var/lib/hades/hades.sqlite
HADES_API_HOST=127.0.0.1
HADES_API_PORT=3101
HADES_PUBLIC_URL=https://hades.20-235-109-146.sslip.io
HADES_ALLOWED_ORIGINS=https://mi-yomi.github.io,http://127.0.0.1:5173,http://localhost:5173
# Must match VITE_ADMIN_EMAIL / VITE_WHITELIST of the frontend build
HADES_ADMIN_EMAIL=your@email.com
HADES_WHITELIST=on
HADES_SESSION_TTL_DAYS=30
HADES_AUTH_RATE_LIMIT=20
HADES_AUTH_RATE_WINDOW=600
# Firebase project whose ID tokens /api/auth/firebase accepts (= VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=
# Server-side Google OAuth redirect flow (/api/auth/google/*). The current
# frontend signs in through Firebase instead, so these may stay empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs OAuth state; generate with: openssl rand -base64 32
HADES_OAUTH_STATE_SECRET=
# Where the Google callback may redirect back to (comma-separated prefixes).
# Defaults to the web app, localhost and the mobile app scheme (myapp://).
# HADES_OAUTH_REDIRECT_PREFIXES=https://mi-yomi.github.io,http://localhost:,http://127.0.0.1:,myapp://
# HDREZKA_MIRRORS=https://kz.rezka.biz,https://rezka.biz,https://hdrezka.tv
